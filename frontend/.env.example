# Copy to frontend/.env.local only if you need it. Everything in a VITE_*
# variable is bundled into the public JavaScript and readable by anyone:
# NEVER put a database password, DATABASE_URL or any Supabase key here.

# Production: the public origin of the deployed FastAPI service (no trailing
# slash, no /api). Leave unset in development, where Vite proxies /api.
# VITE_API_BASE_URL=https://your-ledger-api.example.com

# Development only: the local port uvicorn listens on, if not 8080.
# VITE_BACKEND_PORT=8080
