# Copy this file to .env and fill in your key. .env is gitignored.
#
# A key is optional: forecasts, budgets and savings are computed locally and
# work without one. The key only turns on the written analysis on Overview.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to 8080. Change this if something else is already bound
# to the port, then start the frontend with the same backend port.
# PORT=8081

# Optional. Defaults to gemini-3.6-flash. Use a 3-series model — the request
# sets a thinking level, which older models reject.
# GEMINI_MODEL=gemini-3.6-flash
