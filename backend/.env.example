# Copy to backend/.env and fill in. backend/.env is gitignored; never commit it,
# and never put any of these values in frontend/ or in a VITE_* variable.

# Supabase → Connect → "Session pooler" (IPv4-compatible). Replace
# [YOUR-PASSWORD]; this string IS a server secret.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Browser origins allowed to call the API (comma-separated). The Vite dev
# server proxies /api, so locally this only matters if you call the API directly.
CORS_ORIGINS=http://localhost:5173

# "This month" is decided in this timezone, not the server's.
APP_TZ=Asia/Kolkata

# How many days a sign-in lasts before the user must sign in again.
SESSION_DAYS=7

# Set to false to freeze a deployment: every write, including sign-ups,
# then returns 403.
ALLOW_WRITES=true

# Risk thresholds, % of a category's monthly budget (illustrative defaults).
BUDGET_WARNING_PCT=80
BUDGET_EXCEEDED_PCT=100

# Only for `pytest -m integration`: a DISPOSABLE database (local PostgreSQL or a
# separate Supabase project), never the one above. Tests create and drop their
# own temporary schema there. Not read from this file by pytest — export it.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/ledger_test
